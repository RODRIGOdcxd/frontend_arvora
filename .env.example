# URL del API Spring Boot. Incluye el prefijo /api/v1.
# En un proyecto Vite el equivalente sería VITE_API_URL.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# true  → MSW en el navegador, sin backend.
# false → consume el API real (CORS permite http://localhost:3000).
# Si se omite, `next dev` activa el modo demostración.
NEXT_PUBLIC_API_MOCK=true
